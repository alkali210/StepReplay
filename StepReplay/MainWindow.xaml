<Window
    x:Class="StepReplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="StepReplay">

    <Grid x:Name="RootGrid"
            Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="NavPane"
                Width="64"
                Padding="8,14,8,14">
            <Grid.Resources>
                <!-- Keep navigation buttons flat: no light hover border in light theme. -->
                <Thickness x:Key="ButtonBorderThemeThickness">0</Thickness>
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
            </Grid.Resources>

            <StackPanel Spacing="12">
                <Button x:Name="NavToggleButton"
                        Height="40"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="NavToggleButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE700;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"/>
                        <TextBlock x:Name="NavToggleLabel"
                                Grid.Column="1"
                                Opacity="0"
                                VerticalAlignment="Center"
                                Text="StepReplay"
                                TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <Grid x:Name="NavItemsHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="NavSelectionIndicator"
                                Width="4"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="0,12,0,0"
                                CornerRadius="2"
                                Background="{ThemeResource SystemAccentColor}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NavSelectionIndicatorTransform" Y="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <Button x:Name="HomeNavButton"
                            Grid.Row="0"
                            Height="48"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="HomeNavButton_Click"
                            ToolTipService.ToolTip="主页">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE80F;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"/>
                        <TextBlock x:Name="HomeNavLabel"
                                Grid.Column="1"
                                Opacity="0"
                                VerticalAlignment="Center"
                                Text="主页"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsNavButton"
                            Grid.Row="1"
                            Height="48"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="SettingsNavButton_Click"
                            ToolTipService.ToolTip="设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE713;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"/>
                        <TextBlock x:Name="SettingsNavLabel"
                                Grid.Column="1"
                                Opacity="0"
                                VerticalAlignment="Center"
                                Text="设置"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Column="1"
            Padding="24,12,24,24"
            RowSpacing="14">
        <Grid.Resources>
            <Storyboard x:Name="ShowSettingsStoryboard">
                <DoubleAnimation Storyboard.TargetName="MainPage"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MainPageTransform"
                        Storyboard.TargetProperty="X"
                        To="-24"
                        Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsPage"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsPageTransform"
                        Storyboard.TargetProperty="X"
                        To="0"
                        Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="ShowMainStoryboard">
                <DoubleAnimation Storyboard.TargetName="SettingsPage"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsPageTransform"
                        Storyboard.TargetProperty="X"
                        To="24"
                        Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MainPage"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MainPageTransform"
                        Storyboard.TargetProperty="X"
                        To="0"
                        Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid MinHeight="48"
                ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="138"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TitleBarDragRegion"
                    Grid.Column="0"
                    Background="Transparent"/>

            <TextBlock
                x:Name="SubtitleText"
                IsHitTestVisible="False"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="记录鼠标键盘操作，然后用按钮按原始节奏自动回放。"/>

        </Grid>

        <Grid Grid.Row="1"
                ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="StartButton"
                    Content="开始录制"
                    Click="StartButton_Click"/>
            <Button x:Name="StopButton"
                    Grid.Column="1"
                    Content="停止录制"
                    Click="StopButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="ReplayButton"
                    Grid.Column="2"
                    Content="回放"
                    Click="ReplayButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="ClearButton"
                    Grid.Column="3"
                    Content="清空"
                    Click="ClearButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="SaveButton"
                    Grid.Column="4"
                    Content="保存 JSON"
                    Click="SaveButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="LoadButton"
                    Grid.Column="5"
                    Content="载入 JSON"
                    Click="LoadButton_Click"/>

            <StackPanel Grid.Column="6"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing"
                        Width="20"
                        Height="20"
                        IsActive="False"/>
                <TextBlock x:Name="StatusText"
                        Text="就绪"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid x:Name="MainPage"
                    Opacity="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MainPageTransform"
                            X="0"/>
                </Grid.RenderTransform>

                <ListView x:Name="EventsList"
                        ItemsSource="{x:Bind VisibleEvents, Mode=OneWay}">
                    <ListView.Header>
                        <Grid Padding="8"
                                ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeHeaderText"
                                    Text="时间"
                                    FontWeight="SemiBold"/>
                            <TextBlock x:Name="TypeHeaderText"
                                    Grid.Column="1"
                                    Text="类型"
                                    FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailHeaderText"
                                    Grid.Column="2"
                                    Text="详情"
                                    FontWeight="SemiBold"/>
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4"
                                    ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding OffsetText}"/>
                                <TextBlock Grid.Column="1"
                                        Text="{Binding KindText}"/>
                                <TextBlock Grid.Column="2"
                                        Text="{Binding DetailText}"
                                        TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <TextBlock
                            x:Name="EventsSummaryText"
                            Padding="8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="列表不单独显示鼠标移动事件；回放和 JSON 会保留完整移动轨迹。"/>
                    </ListView.Footer>
                </ListView>
            </Grid>

            <ScrollViewer x:Name="SettingsPage"
                    Opacity="0"
                    Visibility="Collapsed">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="SettingsPageTransform"
                            X="24"/>
                </ScrollViewer.RenderTransform>

                <StackPanel MaxWidth="560"
                        Spacing="18"
                        HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SettingsTitleText"
                                Text="设置"
                                FontSize="24"
                                FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LanguageLabelText"
                                Text="显示语言"/>
                        <ComboBox x:Name="LanguageComboBox"
                                SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="LanguageChineseItem"
                                    Tag="zh-CN"
                                    Content="简体中文"/>
                            <ComboBoxItem x:Name="LanguageEnglishItem"
                                    Tag="en-US"
                                    Content="English"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ThemeLabelText"
                                Text="界面主题"/>
                        <ComboBox x:Name="ThemeComboBox"
                                SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="ThemeDefaultItem"
                                    Tag="Default"
                                    Content="跟随系统"/>
                            <ComboBoxItem x:Name="ThemeLightItem"
                                    Tag="Light"
                                    Content="浅色"/>
                            <ComboBoxItem x:Name="ThemeDarkItem"
                                    Tag="Dark"
                                    Content="深色"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="BackdropLabelText"
                                Text="窗口背景"/>
                        <ComboBox x:Name="BackdropComboBox"
                                SelectionChanged="BackdropComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="BackdropMicaItem"
                                    Tag="Mica"
                                    Content="Mica"/>
                            <ComboBoxItem x:Name="BackdropMicaAltItem"
                                    Tag="MicaAlt"
                                    Content="Mica Alt"/>
                        </ComboBox>
                    </StackPanel>

                    <NumberBox
                        x:Name="RecordDelayBox"
                        Header="开始录制延迟（秒）"
                        Minimum="0"
                        Maximum="60"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="RecordDelayBox_ValueChanged"/>

                    <NumberBox
                        x:Name="ReplayDelayBox"
                        Header="开始回放延迟（秒）"
                        Minimum="0"
                        Maximum="60"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="ReplayDelayBox_ValueChanged"/>

                    <NumberBox
                        x:Name="ReplayRepeatCountBox"
                        Header="回放次数"
                        Minimum="1"
                        Maximum="999"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="ReplayRepeatCountBox_ValueChanged"/>

                    <ToggleSwitch
                        x:Name="ShowMouseMovesSwitch"
                        Header="在列表中显示鼠标轨迹记录"
                        Toggled="ShowMouseMovesSwitch_Toggled"/>

                    <TextBlock x:Name="HotkeysTitleText"
                            Text="快捷键"
                            FontSize="18"
                            FontWeight="SemiBold"/>

                    <TextBox
                        x:Name="StartRecordingHotkeyBox"
                        Header="开始录制"
                        PlaceholderText="未设置"
                        IsReadOnly="True"
                        GotFocus="HotkeyBox_GotFocus"
                        LostFocus="HotkeyBox_LostFocus"
                        KeyDown="HotkeyBox_KeyDown"/>

                    <TextBox
                        x:Name="StopRecordingHotkeyBox"
                        Header="结束录制"
                        PlaceholderText="未设置"
                        IsReadOnly="True"
                        GotFocus="HotkeyBox_GotFocus"
                        LostFocus="HotkeyBox_LostFocus"
                        KeyDown="HotkeyBox_KeyDown"/>

                    <TextBox
                        x:Name="StartReplayHotkeyBox"
                        Header="开始回放"
                        PlaceholderText="未设置"
                        IsReadOnly="True"
                        GotFocus="HotkeyBox_GotFocus"
                        LostFocus="HotkeyBox_LostFocus"
                        KeyDown="HotkeyBox_KeyDown"/>

                    <TextBox
                        x:Name="StopReplayHotkeyBox"
                        Header="停止回放"
                        PlaceholderText="未设置"
                        IsReadOnly="True"
                        GotFocus="HotkeyBox_GotFocus"
                        LostFocus="HotkeyBox_LostFocus"
                        KeyDown="HotkeyBox_KeyDown"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <InfoBar
            x:Name="TipInfoBar"
            Grid.Row="3"
            IsOpen="True"
            Severity="Informational"
            Title="提示"
            Message="开始录制和回放都有 3 秒准备时间；录制期间会忽略本窗口内操作；回放会真实控制桌面。"/>
        </Grid>
    </Grid>
</Window>
